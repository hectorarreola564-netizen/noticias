# Conexión a Postgres de Supabase. Usa la cadena "Connection pooling" (puerto 6543),
# no la directa: Vercel abre y cierra conexiones en cada request.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# Secreto compartido entre GitHub Actions y la ruta /api/sync. Genera uno con:
#   openssl rand -hex 32
CRON_SECRET="cambia-esto"
