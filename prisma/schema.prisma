generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Una sola tabla: la app no guarda nada del usuario (sin login, acuerdo del v1),
// solo la ventana de 7 días de titulares. La purga la hace cada corrida de /api/sync.
model Article {
  id String @id @default(cuid())

  // URL ya limpia de parámetros de rastreo. Es la llave real de deduplicado:
  // dos feeds que traen la misma nota chocan aquí y el upsert la deja en una.
  url String @unique

  // Titular normalizado (minúsculas, espacios colapsados). Segundo criterio de
  // deduplicado, para cuando dos medios publican el mismo titular en URLs propias.
  titleKey String

  title    String
  summary  String @default("")

  // Foto de la nota, tomada del módulo Media RSS. Opcional a propósito: hay
  // medios (La Jornada) que no publican foto por nota, y la tarjeta se diseña
  // para verse bien sin ella.
  imageUrl String?

  sourceId   String
  sourceName String
  category   String
  region     String
  lang       String

  publishedAt DateTime
  fetchedAt   DateTime @default(now())

  // El feed se lee siempre en orden cronológico y recortado por fecha.
  @@index([publishedAt])
  @@index([titleKey])
  @@index([category])
}

/**
 * Un navegador suscrito a las notificaciones. En iOS solo existe cuando la app
 * está instalada en la pantalla de inicio: Safari no permite Web Push desde una
 * pestaña normal.
 */
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  // Se marca cuando el servicio de push responde que caducó, para dejar de
  // intentarlo en cada sincronización.
  failedAt  DateTime?
}

/** Estado interno de la app. Hoy solo guarda cuándo se mandó el último aviso. */
model Ajuste {
  clave String   @id
  valor String
  actualizadoAt DateTime @updatedAt
}
